{
  "cli": {
    "version": ">= 7.8.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "node": "20.11.0",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "20.11.0",
      "android": {
        "buildType": "apk"
      }
    },
    "osvi2026": {
      "distribution": "internal",
      "node": "20.11.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "osvi2026"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
